{
  "name": "@nullean/journeys",
  "version": "0.1.0",
  "description": "Parse and run Nullean.Cdp journeys (agent-browser commands, one per line) on Playwright: in Playwright Test, or pushed to Elastic Synthetics.",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/nullean/cdp.git", "directory": "js/journeys" },
  "bin": { "journeys": "./dist/cli.js" },
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./test": { "types": "./dist/adapters/test.d.ts", "default": "./dist/adapters/test.js" },
    "./synthetics": { "types": "./dist/adapters/synthetics.d.ts", "default": "./dist/adapters/synthetics.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "test:live": "playwright test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45",
    "playwright-core": ">=1.45"
  },
  "peerDependenciesMeta": {
    "@playwright/test": { "optional": true },
    "playwright-core": { "optional": true }
  },
  "devDependencies": {
    "@elastic/synthetics": "1.29.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=20" }
}
