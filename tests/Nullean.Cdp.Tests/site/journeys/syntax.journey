# The commands the other two journeys do not run: parsed and exported, never run. The corpus for the JSON contract
# (cdp parse) and for runners in other languages.
allow shop.test *.shop.test
open https://shop.test/
set media dark
set headers '{"x-test": "1"}'
set credentials admin $env:SHOP_PASSWORD
set offline
click #go
find role button click --name "Add red lamp" --exact
find first "nav a" text
find nth 2 .card hover
upload #file files/note.txt note.txt
press Control+a
keyboard type "hi there"
wait --text "3 results"
timings
vitals --budget lcp=2500 cls=0.1
metrics --budget Nodes=1500
network har start
network requests --filter api --type xhr,fetch --method post --status 4xx
network requests --failed --strict
network requests --clear
network har stop out/run.har
links -s main --external --all --strict
a11y -s main --strict
screenshot #box box.png
screenshot shots/page.png --full
console
errors
console --clear
errors --clear
get styles #box
get attr #name placeholder
is visible #hello
expect visible #go
expect --not hidden find role button --name Save --exact
expect enabled #go
expect disabled #off
expect checked find label Newsletter
expect unchecked #plain
expect focused #name
expect editable #name
expect attached #hidden
expect empty #blank
expect text #count "2 results"
expect text #count results --contains --ignore-case --inner-text
expect text find role heading --name Actions "Actions"
expect text #count "^\d+ results$" --regex
expect value #name Ada
expect attr #name placeholder
expect attr #name data-state ready --contains
expect class #go "primary big"
expect class #go big --contains
expect count li 3
expect --timeout 1500 visible find first li
expect text find nth 2 li Three
expect value #pw $env:SHOP_PASSWORD
expect title Loaded
expect title Load --contains
expect url "**/about.html"
expect --not url "**/error" --ignore-case
expect request "**/chunk-*.js"
expect --timeout 20000 request "**/_api/v1/o/l" --method post --type fetch,xhr --status 2xx
expect --not request "**/_api/v1/o/*" --failed
expect --not request "**/_api/v1/o/*" --larger-than 32kb
expect request "**/_api/v1/o/l" --body-contains '"docs-frontend"'
expect request "**/_api/v1/o/l" --body-regex '"session\.id"'
expect same-document
expect --not --timeout 3000 same-document
